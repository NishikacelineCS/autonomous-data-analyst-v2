# =============================================================================
# requirements.txt — Autonomous Multi-Agent Data Analyst System
# =============================================================================
# Pin versions for reproducibility in production.
# Regenerate with: pip freeze > requirements-lock.txt after installing.
#
# Installation:
#   python -m venv venv && source venv/bin/activate
#   pip install -r requirements.txt
# =============================================================================

# ── Web Framework ─────────────────────────────────────────────────────────────
fastapi==0.115.4               # Async REST API framework with auto OpenAPI docs
uvicorn[standard]==0.32.1      # ASGI server; [standard] adds uvloop + httptools
python-multipart==0.0.12       # Required for FastAPI file upload (multipart/form-data)
starlette==0.41.2              # FastAPI is built on Starlette; pin for compatibility

# ── Configuration & Validation ───────────────────────────────────────────────
pydantic==2.9.2                # Data validation and serialization (v2 API)
pydantic-settings==2.6.1       # .env file loading with type validation

# ── LangGraph Multi-Agent Orchestration ──────────────────────────────────────
# WHY LANGGRAPH: Provides explicit stateful workflow graphs with:
# - Checkpointing (resume interrupted workflows)
# - Conditional routing between agents
# - Parallel node execution
# - Human-in-the-loop interruptions
langgraph==0.2.50              # Core orchestration library
langchain-core==0.3.21         # Shared LangChain primitives (compatible with 0.2.50)

# ── AI Model SDKs ────────────────────────────────────────────────────────────
# Using Anthropic SDK directly (not via LangChain wrapper) for:
# - Full control over streaming and tool_use blocks
# - Access to latest Claude features without LangChain abstraction overhead
# - Better error handling and retry logic
anthropic==0.39.0              # Anthropic Python SDK (Claude Sonnet 4)

# Optional: Google Gemini as fallback provider
# google-generativeai==0.8.3   # Uncomment if using Gemini

# ── Data Processing ──────────────────────────────────────────────────────────
pandas==2.2.3                  # Core dataframe operations
numpy==1.26.4                  # Numerical computing (pinned below 2.0 for compatibility)
openpyxl==3.1.5                # Excel (.xlsx) read/write
xlrd==2.0.1                    # Legacy Excel (.xls) read support
pyarrow==18.0.0                # Fast Parquet I/O; also accelerates pandas operations

# ── Analytics & In-Process SQL ───────────────────────────────────────────────
# WHY DUCKDB: Columnar analytics engine that:
# - Runs in-process (no separate server)
# - Executes SQL directly on pandas DataFrames/Parquet files
# - Handles 100M+ rows efficiently on a laptop
# - Supports complex analytics SQL (window functions, aggregates, joins)
duckdb==1.1.3

# ── Vector Database (Long-Term Agent Memory) ─────────────────────────────────
# WHY CHROMADB: Stores analysis summaries as vector embeddings so the system
# can retrieve relevant past insights when answering follow-up questions.
# Local-first (file-backed), zero infrastructure required.
chromadb==0.5.20

# ── Visualizations ────────────────────────────────────────────────────────────
plotly==5.24.1                 # Interactive charts; JSON-serializable figures
kaleido==0.2.1                 # Static image export (PNG/SVG) from Plotly figures

# ── Frontend ─────────────────────────────────────────────────────────────────
streamlit==1.40.1              # Rapid web UI; perfect for data + AI apps

# ── HTTP Client (Frontend → Backend communication) ───────────────────────────
httpx==0.28.0                  # Async HTTP client; used in Streamlit to call FastAPI
aiofiles==24.1.0               # Async file I/O for backend file operations

# ── Security (Sandboxed Code Execution) ──────────────────────────────────────
# WHY RESTRICTEDPYTHON: AI-generated code is executed dynamically.
# RestrictedPython prevents dangerous operations like file system access,
# subprocess calls, or arbitrary imports.
RestrictedPython==7.3

# ── Utilities ─────────────────────────────────────────────────────────────────
python-dotenv==1.0.1           # Load .env files (used in config.py)
structlog==24.4.0              # Structured, context-rich logging
rich==13.9.4                   # Beautiful terminal output for development
python-json-logger==2.0.7      # JSON log formatting for production log aggregation

# ── Testing ───────────────────────────────────────────────────────────────────
pytest==8.3.3
pytest-asyncio==0.24.0         # Async test support for FastAPI routes

# ── Development (remove from production image) ───────────────────────────────
black==24.10.0                 # Code formatter
isort==5.13.2                  # Import sorter